# Leave VITE_CORE_SERVER_URL blank to use the local server embedded in the desktop app.
# For shared accounts and conversations, set this to your HTTPS CORE server.
VITE_CORE_SERVER_URL=

# Shared server settings (used by `npm run server`).
PORT=4179
CORE_BIND_ADDRESS=0.0.0.0
CORE_PUBLIC_URL=
CORE_ALLOWED_ORIGINS=http://127.0.0.1:4179,http://127.0.0.1:5173
CORE_DATA_DIR=./core-data

# Optional WebRTC service configuration. CORE issues one-hour coturn REST credentials
# from the server secret; the secret stays here and is never included in the desktop app.
CORE_STUN_URLS=stun:stun.l.google.com:19302
CORE_TURN_URLS=
CORE_TURN_SECRET=
